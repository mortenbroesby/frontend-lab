{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    ".nvmrc"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/gallery/vite.demo.config.ts",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_GALLERY_URL"
      ]
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  }
}
