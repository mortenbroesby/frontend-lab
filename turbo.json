{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tracks/c/**/*.mjs"],
  "globalEnv": ["VITE_SOURCE_URL"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "preview": { "cache": false, "persistent": true },
    "build": { "outputs": ["dist/**"] },
    "check": { "outputs": ["dist/**"] },
    "test": { "outputs": [] },
    "test:browser": { "cache": false, "passThroughEnv": ["PLAYWRIGHT_CHANNEL"] }
  }
}
