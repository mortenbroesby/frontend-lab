{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tracks/developer-experience/**/*.mjs",
    "gallery/src/**",
    "gallery/vite.demo.config.ts",
    "gallery/demo-kit/**",
    "demos/**",
    "index.html",
    "shared/**"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**"
      ]
    },
    "check": {
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "outputs": []
    }
  },
  "globalEnv": [
    "VITE_GALLERY_URL"
  ]
}
