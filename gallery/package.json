{
  "name": "frontend-lab-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts exercises/tooling/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.ts exercises/tooling/*.test.mjs",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@lab/demo-kit": "*",
    "@lab/ui": "*",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
