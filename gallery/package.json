{
  "name": "front-end-lab-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/art.test.ts tests/compute.test.ts tests/demo-contract.test.ts ../tracks/developer-experience/bootstrap/inspect.test.mjs ../tracks/developer-experience/examples/commands.test.mjs",
    "test:watch": "node --test --watch tests/art.test.ts tests/compute.test.ts tests/demo-contract.test.ts ../tracks/developer-experience/bootstrap/inspect.test.mjs ../tracks/developer-experience/examples/commands.test.mjs",
    "check": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@lab/demo-kit": "*"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
