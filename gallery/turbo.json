{
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/index.html",
        "$TURBO_ROOT$/demos/**",
        "!$TURBO_ROOT$/demos/**/dist/**",
        "!$TURBO_ROOT$/demos/**/.turbo/**",
        "!demo-kit/**",
        "!$TURBO_ROOT$/demos/**/node_modules/**",
        "$TURBO_ROOT$/.env*",
        "$TURBO_ROOT$/showcases/**",
        "!$TURBO_ROOT$/showcases/**/dist/**",
        "!$TURBO_ROOT$/showcases/**/.turbo/**",
        "!$TURBO_ROOT$/showcases/**/node_modules/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/demos/*/demo.config.ts",
        "!demo-kit/**",
        "$TURBO_ROOT$/showcases/*/showcase.config.ts"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!demo-kit/**"
      ]
    }
  }
}
