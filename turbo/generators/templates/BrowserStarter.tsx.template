import { Label } from '@lab/ui/label';
import { Slider } from '@lab/ui/slider';
import { useState } from 'react';

// A place to try an API, not a finished visualisation.
export function BrowserStarter() {
  const [radius, setRadius] = useState(30);
  return (
    <div className="experiment-grid">
      <div className="visual-stage">
        <svg viewBox="0 0 400 260" role="img" aria-label={`One circle with radius ${radius}`}>
          <circle cx="200" cy="130" r={radius} fill="#24483e" />
        </svg>
      </div>
      <div className="controls">
        <h2>One shape. Your next question.</h2>
        <p>
          Change a value, then try a browser API. This starter has no finished graph, Worker or
          messaging solution.
        </p>
        <Label id="radius-label">
          Circle radius <output>{radius}</output>
        </Label>
        <Slider
          aria-labelledby="radius-label"
          min={10}
          max={90}
          value={[radius]}
          onValueChange={([value]) => setRadius(value)}
        />
        <p>
          To get your own copy, run <code>npm run demo:new</code> and choose Modern Web
          Capabilities. Change the circle’s fill in <code>index.tsx</code>, save and refresh to
          confirm it persists. Then add an interaction.
        </p>
      </div>
    </div>
  );
}
