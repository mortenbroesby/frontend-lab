{
  "name": "front-end-lab-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/art.test.ts tests/compute.test.ts tests/demo-contract.test.ts ../tracks/c/bootstrap/inspect.test.mjs ../tracks/c/examples/commands.test.mjs",
    "test:watch": "node --test --watch tests/art.test.ts tests/compute.test.ts tests/demo-contract.test.ts ../tracks/c/bootstrap/inspect.test.mjs ../tracks/c/examples/commands.test.mjs",
    "check": "npm run typecheck && npm test && vite build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "d3-force": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
