{
  "name": "frontend-chapter-day",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "gallery",
    "demos/*",
    "gallery/demo-kit",
    "shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=front-end-lab-gallery",
    "build": "turbo run build",
    "preview": "turbo run preview --filter=front-end-lab-gallery",
    "demo:new": "turbo gen demo",
    "test:servers": "node --test tests/servers.test.mjs",
    "test:generator": "node --test turbo/generators/create-demo.test.mjs",
    "test": "npm run test:workspaces && npm run test:generator && turbo run test",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm test && turbo run typecheck build",
    "analyze": "fallow",
    "analyze:dead-code": "fallow dead-code",
    "analyze:dupes": "fallow dupes",
    "analyze:health": "fallow health",
    "analyze:architecture": "fallow architecture",
    "fallow:hooks": "fallow hooks install --target git",
    "fallow:status": "fallow doctor && fallow hooks status",
    "analyze:changes": "fallow audit",
    "check:architecture": "depcruise gallery/src gallery/demo-kit demos shared",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"{gallery,demos,shared,turbo,tests}/**/*.{ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"{gallery,demos,shared,turbo,tests}/**/*.{ts,tsx,js,mjs,css}\"",
    "lint": "oxlint gallery demos shared --deny-warnings",
    "test:workspaces": "node --test tests/workspaces.test.mjs",
    "analyze:baseline": "fallow dead-code --baseline .baselines/dead-code.json && fallow dupes --baseline .baselines/dupes.json --fail-on-issues && fallow health --baseline .baselines/health.json --baseline-mode identity",
    "storybook": "npm run storybook --workspace @lab/ui",
    "storybook:build": "npm run storybook:build --workspace @lab/ui",
    "storybook:tools": "npm run storybook:tools --workspace @lab/ui --"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "4.3.5",
    "@turbo/gen": "2.11.11",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.7.2",
    "fallow": "3.43.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "remark-gfm": "4.0.1",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
